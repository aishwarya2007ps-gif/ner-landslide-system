# ==============================================================
# AI-Based Early Warning & Landslide Risk Monitoring System in NER
# Environment Configuration Template (.env.example)
# ==============================================================

# Database Connection (Default is SQLite for local zero-dependency run)
DATABASE_URL=sqlite:///./ner_disaster.db
# For PostgreSQL/PostGIS in production:
# DATABASE_URL=postgresql://ner_admin:ner_secure_password_2026@localhost:5432/ner_disaster_db

# Redis Cache & Queue
REDIS_URL=redis://localhost:6379/0

# Security & Session Authentication
SECRET_KEY=ner_super_secret_jwt_key_prototype_2026_disaster_system
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# India Meteorological Department (IMD) API Credentials
# If token is empty, system automatically operates in realistic NER prototype demo mode
IMD_API_BASE_URL=https://api.imd.gov.in/v1/forecast
IMD_API_TOKEN=

# Satellite Observation Metadata Provider
SATELLITE_PROVIDER_URL=https://sentinel.esa.int/api/v1

# SMS Gateway (e.g. CDAC Emergency SMS / Twilio / Mock)
SMS_PROVIDER=mock
SMS_API_KEY=

# Email Gateway (e.g. SMTP / SendGrid / Mock)
EMAIL_PROVIDER=mock
EMAIL_API_KEY=

# OpenStreetMap Leaflet Tile Provider Configuration
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

# Frontend Vite API Gateway
VITE_API_BASE_URL=http://localhost:8000
